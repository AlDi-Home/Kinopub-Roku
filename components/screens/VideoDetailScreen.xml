<?xml version="1.0" encoding="utf-8" ?>
<component name="VideoDetailScreen" extends="Group">
  <interface>
    <field id="selection" type="assocarray" />
    <field id="backRequested" type="boolean" alwaysNotify="true" />
    <field id="authRequired" type="boolean" alwaysNotify="true" />
    <field id="playbackRequested" type="assocarray" alwaysNotify="true" />
    <field id="playbackError" type="string" alwaysNotify="true" />
    <field id="reloadRequested" type="boolean" alwaysNotify="true" />
    <field id="nextPlaybackRequested" type="assocarray" alwaysNotify="true" />
    <field id="nextPlayback" type="assocarray" alwaysNotify="true" />
  </interface>
  <children>
    <Rectangle width="1280" height="720" color="#EEF5F8" />

    <Group id="loadingGroup" translation="[96,72]">
      <Label text="Загрузка..." color="#5B6B79" />
    </Group>

    <Group id="errorGroup" translation="[96,72]" visible="false">
      <Label id="errorLabel" text="Не удалось загрузить видео" color="#E11D2E" width="900" />
      <Group id="retryButton" translation="[0,64]">
        <Rectangle id="retryFocusBg" width="190" height="48" color="#BFDBFE" />
        <Label text="Повторить" translation="[58,14]" color="#111827" />
      </Group>
    </Group>

    <!-- Hero backdrop fills the whole screen as a STATIC background layer —
         a direct child of detailGroup, never translated, so it stays put
         and stays full-bleed no matter how far the foreground content below
         scrolls. (An earlier version nested the backdrop inside the group
         that scrolls when entering the episode list — once scrolled up, the
         backdrop's own bottom edge moved with it, exposing flat canvas
         below. Splitting it out fixes that.) Scrim is a pre-rendered
         vertical gradient PNG (images/ui/backdrop-scrim.png, 4x512 black
         alpha ramp, stretched to fill) darkening toward the bottom — Roku's
         Rectangle has no native gradient, and stacking flat semi-transparent
         rectangles compounds their opacity in the overlap zones, producing
         visible dark seams at each boundary (tried first, didn't work). -->
    <Group id="detailGroup" visible="false">
      <Rectangle id="heroFallbackBg" width="1280" height="720" color="#111827" />
      <Poster id="backdropPoster" width="1280" height="720" loadDisplayMode="scaleToZoom" />
      <Poster id="heroScrimGradient" width="1280" height="720" loadDisplayMode="scaleToFill" uri="pkg:/images/ui/backdrop-scrim.png" />

      <!-- Foreground content — this whole group scrolls up as one unit when
           entering the episode list (videoDetailScreenSetHeroScrolled),
           sliding over the static backdrop above. -->
      <Group id="detailScrollHost" translation="[0,0]">
        <Group id="heroGroup" translation="[0,0]">
          <Label id="heroTitleLabel" translation="[64,32]" width="820" height="40" color="#FFFFFF" />
          <Label id="heroMetaLabel" translation="[64,76]" width="820" height="22" color="#D1D9E0" />
          <Group id="heroBadgesHost" translation="[64,100]" />
          <Rectangle id="descriptionFocusBg" translation="[54,120]" width="800" height="96" color="#FFFFFF" opacity="0" />
          <Label id="heroDescriptionLabel" translation="[64,128]" width="820" height="84" wrap="true" color="#E5E7EB" />

          <Group id="heroActionsHost" translation="[64,222]" />
          <Label id="playbackErrorLabel" translation="[340,222]" width="480" height="24" color="#FCA5A5" visible="false" />
        </Group>

        <!-- Below the hero: "content" (a vertically-scrollable stack of
             heterogeneous rows — seasons tiles, recommendations rail,
             ratings, tech info, built entirely at runtime by
             videoDetailScreenRenderContent) and the episode list are
             mutually exclusive "sub-views" sharing the same region, not
             simultaneously visible (matches the reference app's flow — see
             VideoDetailScreen.brs's videoDetailScreenApplySectionVisibility).
             No background of their own — they sit directly on the backdrop
             above, with light/white text and semi-transparent row chrome
             (set in VideoDetailScreen.brs) so the image shows through. -->
        <Group id="belowHeroHost" translation="[0,380]">
          <Group id="contentSection" visible="false">
            <Group id="contentClipHost">
              <Group id="contentHost" />
            </Group>
          </Group>

          <Group id="episodesSection" visible="false">
            <Label id="episodesHeadingLabel" text="" translation="[64,20]" width="700" height="26" color="#FFFFFF" />
            <Group id="episodesClipHost">
              <Group id="episodesHost" />
            </Group>
            <Label id="noMediaLabel" text="Видео недоступно" translation="[64,60]" width="700" color="#D1D9E0" visible="false" />
          </Group>
        </Group>
      </Group>
    </Group>

    <!-- Restyled to the light dialog aesthetic (ListPickerDialog/
         ExitConfirmDialog); kept inline (not a shared component — a
         multi-toggle folder list with exactly one caller) but follows the
         same "never takes real focus" rule: the screen keeps focus and
         checks m.bookmarkOverlayOpen at the top of its own onKeyEvent. -->
    <Group id="bookmarkOverlayGroup" visible="false">
      <Rectangle width="1280" height="720" color="#000000" opacity="0.55" />
      <Group translation="[430,150]">
        <Rectangle width="420" height="420" color="#FFFFFF" />
        <Label text="Закладки" translation="[20,16]" width="380" height="30" color="#111827" />
        <Label id="bookmarkOverlayStatusLabel" text="" translation="[20,52]" width="380" height="22" color="#5B6B79" />
        <Group id="bookmarkOverlayFoldersHost" translation="[20,84]" />
      </Group>
    </Group>

    <!-- Full-description "semiwindow" — OK on the focused description text
         in the hero opens this; Back or OK closes it and returns focus to
         wherever it was (the screen never actually moves real focus here,
         same "dialog never takes real focus" pattern as bookmarkOverlayGroup
         above). Dark panel (not the light dialog style) since it's showing
         hero-originated text, consistent with the hero's own palette. -->
    <Group id="descriptionOverlayGroup" visible="false">
      <Rectangle width="1280" height="720" color="#000000" opacity="0.7" />
      <Group translation="[190,140]">
        <Rectangle width="900" height="440" color="#111827" />
        <Label id="descriptionOverlayTitleLabel" text="" translation="[32,24]" width="836" height="34" color="#FFFFFF" />
        <Label id="descriptionOverlayTextLabel" text="" translation="[32,72]" width="836" height="320" wrap="true" color="#E5E7EB" />
        <Label text="Назад — закрыть" translation="[32,404]" width="600" height="24" color="#9CA3AF" />
      </Group>
    </Group>
  </children>
  <script type="text/brightscript" uri="pkg:/components/theme/UiTheme.brs" />
  <script type="text/brightscript" uri="pkg:/components/cards/PosterCard.brs" />
  <script type="text/brightscript" uri="pkg:/components/screens/VideoDetailScreen.brs" />
</component>
